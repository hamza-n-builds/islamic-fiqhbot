# Copy to .env and fill in. Never commit the real .env.
GEMINI_API_KEY=
# Hybrid retrieval weight (BM25 share; semantic = 1 - alpha)
HYBRID_ALPHA=0.45

# Optional: path to the fine-tuned MiniLM folder. If absent, base MiniLM is used.
# MINILM_DIR=./models/islamic_minilm

# Optional dataset overrides (defaults point to ./data/*)
# FIQH_FILE=./data/fiqh_topics_complete_expanded.yaml
# QURAN_FILE=./data/quran_trilingual_clean.json
# HADITH_FILE=./data/sahih_bukhari_muslim.json
# EXAMPLE_FILE=./data/topic_examples_expanded.yaml

# --- WhatsApp Cloud API (free for customer-initiated/service conversations) ---
WA_VERIFY_TOKEN=fiqh-verify
WA_TOKEN=your_whatsapp_access_token
WA_PHONE_NUMBER_ID=your_phone_number_id

MONGODB_URI=
WHISPER_SIZE=
LOW_CONFIDENCE_PCT=70

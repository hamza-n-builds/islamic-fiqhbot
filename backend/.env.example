# Copy to .env and fill in. Never commit the real .env.
GEMINI_API_KEY=
# Optional private random secret of at least 32 bytes for signed response receipts.
# Keep stable across restarts/workers to allow verified translation follow-ups.
# If blank, receipts are process-local; old chat answers must be asked again after restart.
FIQHBOT_RESPONSE_SECRET=
# Hybrid retrieval weight (BM25 share; semantic = 1 - alpha)
HYBRID_ALPHA=0.45

# Optional: path to the fine-tuned MiniLM folder. If absent, base MiniLM is used.
# MINILM_DIR=./models/islamic_minilm

# Optional dataset overrides (defaults point to ./data/*)
# FIQH_FILE=./data/fiqh_topics_complete_expanded.yaml
# QURAN_FILE=./data/quran_trilingual_clean.json
# HADITH_FILE=./data/sahih_bukhari_muslim.json
# OTHER_HADITH_FILE=./data/other_hadith.json
# HADITH_REGISTRY_FILE=./data/hadith_identity_registry.json
# EXAMPLE_FILE=./data/topic_examples_expanded.yaml

# --- WhatsApp Cloud API (free for customer-initiated/service conversations) ---
# Choose a private random token for the GET subscription handshake.
WA_VERIFY_TOKEN=
# Meta App Secret used to verify every POST webhook signature. Required for WhatsApp.
WA_APP_SECRET=
WA_TOKEN=your_whatsapp_access_token
WA_PHONE_NUMBER_ID=your_phone_number_id
# Optional public phone number for the sidebar shortcut (digits with country code).
# Leave blank to hide the shortcut until WhatsApp is ready.
WA_PUBLIC_NUMBER=
# Optional comma-separated frontend origins. Same-origin UI needs no setting.
FIQHBOT_ALLOWED_ORIGINS=

MONGODB_URI=
WHISPER_SIZE=
# Legacy name: private retrieval-abstention policy only, NOT accuracy percent.
# Kept for existing installations; no confidence percentage is returned/displayed.
# Higher cutoffs remain stricter. Dataset consensus flags never boost this gate.
LOW_CONFIDENCE_PCT=70
